{
  "formatVersion": 1,
  "quintNpm": "@informalsystems/quint",
  "quintVersion": "0.33.1",
  "nodeEngines": ">=20",
  "javaForVerify": ">=21",
  "verifyBackendDefault": "apalache",
  "verifyBackends": ["apalache", "tlc"],
  "simulateBackendDefault": "rust",
  "simulateBackends": ["rust", "typescript"],
  "defaultProfileBudgets": {
    "simulation": { "maxSamples": 200, "maxSteps": 25, "timeoutSeconds": 300 },
    "test": { "maxSamples": 100, "timeoutSeconds": 300 },
    "verify": { "maxSteps": 10, "timeoutSeconds": 600 }
  },
  "supportedDomains": [
    "api",
    "auth",
    "database",
    "distributed",
    "concurrency",
    "jobs",
    "sync",
    "files",
    "recovery"
  ],
  "gates": ["parse", "typecheck", "simulate", "test", "verify"],
  "evidenceDir": ".formal-verification/evidence",
  "modelsDir": ".formal-verification/models",
  "quintTimeoutSeconds": 600,
  "attribution": "Formal specifications are executed with Quint (https://github.com/quint-co/quint). Quint is a separate project by its own authors; this harness only drives its CLI and records the results."
}
